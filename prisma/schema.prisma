generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String?
  email           String    @unique
  username        String    @unique
  password        String
  visitedAirports Airport[] @relation("VisitedAirports")
}

model Airport {
  id                 Int     @id @default(autoincrement())
  country            String
  city               String
  airportCode        String  @unique
  icaoCode           String? @unique
  airportName        String
  runwayLengthMeters Int?
  size               String
  description        String?
  visitedByUsers     User[]  @relation("VisitedAirports")
}
