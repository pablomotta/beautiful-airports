generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String?
  email           String    @unique
  username        String    @unique
  password        String
  visits          Visit[]
}

model Airport {
  id                 Int     @id @default(autoincrement())
  country            String
  city               String
  airportCode        String  @unique
  icaoCode           String? @unique
  airportName        String
  runwayLengthMeters Int?
  size               String
  description        String?
  visits             Visit[]
}

model Visit {
  id        Int      @id @default(autoincrement())
  userId    Int
  airportId Int
  visitedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  airport   Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@unique([userId, airportId])
}
